# Sito Dott. Umberto Fama - configurazione Apache per l'hosting Aruba
# (sostituisce le funzioni server della preview Railway)

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddCharset utf-8 .html .md .txt .json .js .css .xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dominio principale con www e https: attivare dopo aver verificato il certificato SSL su Aruba
  # (togliere il # dalle 4 righe seguenti)
  # RewriteCond %{HTTPS} !=on [OR]
  # RewriteCond %{HTTP_HOST} !^www\. [NC]
  # RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  # RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L,NE]

  # Vecchio indirizzo della pagina del Dottore
  RewriteRule ^chi-siamo/?$ /chi-sono/ [R=301,L]

  # Pagine senza barra finale -> con barra finale (come sulla preview)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Endpoint MCP in sola lettura (script PHP)
  RewriteRule ^mcp/?$ mcp.php [L,QSA]

  # Markdown per gli agenti AI: Accept: text/markdown -> index.md della stessa pagina
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1index.md -f
  RewriteRule ^((?:.+/)?)(?:index\.html)?$ /$1index.md [L,E=MDNEG:1]
</IfModule>

<IfModule mod_headers.c>
  # Le pagine cambiano formato in base all'intestazione Accept
  <FilesMatch "\.(html|md)$">
    Header merge Vary Accept
  </FilesMatch>
  # Risorse per agenti sulla home
  <If "%{REQUEST_URI} =~ m#^/(index\.(html|md))?$#">
    Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\", </ai-catalog.json>; rel=\"describedby\"; type=\"application/json\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\""
  </If>
  <FilesMatch "^(server-card\.json|ai-catalog\.json|llms\.txt)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # Sicurezza di base
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Cache: file statici a lungo, pagine sempre rivalidate
  <FilesMatch "\.(woff2|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|md|txt|json|xml|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
