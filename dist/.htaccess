# Sito Dott. Umberto Fama - configurazione Apache per l'hosting Aruba
# (sostituisce le funzioni server della preview Railway)

Options -Indexes

# Stato della sincronizzazione FTP del deploy: non va servito
<Files "ftp-deploy-sync-state.json">
  Require all denied
</Files>
DirectoryIndex index.html
ErrorDocument 404 /404.html
AddDefaultCharset utf-8

<IfModule mod_mime.c>
  AddType text/markdown .md
  AddType application/json .json
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
  AddCharset utf-8 .html .md .txt .json .js .css .xml
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Dominio principale: sempre https://www.dottorfamaumberto.it
  # (X-Forwarded-Proto evita cicli di redirect se Aruba termina l'SSL su un proxy)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{HTTP_HOST} ^(www\.)?dottorfamaumberto\.it$ [NC]
  RewriteRule ^ https://www.dottorfamaumberto.it%{REQUEST_URI} [R=301,L,NE]
  RewriteCond %{HTTP_HOST} ^dottorfamaumberto\.it$ [NC]
  RewriteRule ^ https://www.dottorfamaumberto.it%{REQUEST_URI} [R=301,L,NE]

  # Il modulo contatti risponde solo via POST: nessuna riscrittura per invia.php
  RewriteRule ^invia\.php$ - [L]

  # Vecchi indirizzi del sito WordPress -> pagine nuove (da SEO Migration Audit)
  # Confronto esatto (con o senza barra finale), destinazione assoluta: un solo redirect.
  # Paginazione: tutte le pagine successive vanno alla stessa destinazione.
  RewriteRule ^author/wp-backend/page/[0-9]+/?$ https://www.dottorfamaumberto.it/mappa-del-sito/ [R=301,L]
  RewriteRule ^category/blog/page/[0-9]+/?$ https://www.dottorfamaumberto.it/tecnologie/ [R=301,L]
  RewriteRule ^category/chirurgia-estetica/page/[0-9]+/?$ https://www.dottorfamaumberto.it/chirurgia-estetica-roma-aprilia/ [R=301,L]
  RewriteRule ^category/medicina-estetica/page/[0-9]+/?$ https://www.dottorfamaumberto.it/medicina-estetica-roma-aprilia/ [R=301,L]
  RewriteRule ^category/trattamenti-laser/page/[0-9]+/?$ https://www.dottorfamaumberto.it/trattamenti-laser-roma-aprilia/ [R=301,L]
  RewriteRule ^author/wp-backend/?$ https://www.dottorfamaumberto.it/chi-sono/ [R=301,L]
  RewriteRule ^category/blog/?$ https://www.dottorfamaumberto.it/blog/ [R=301,L]
  RewriteRule ^category/chirurgia-dermatologica/?$ https://www.dottorfamaumberto.it/chirurgia-dermatologica-roma-aprilia/ [R=301,L]
  RewriteRule ^category/chirurgia-estetica/?$ https://www.dottorfamaumberto.it/chirurgia-estetica-roma-aprilia/ [R=301,L]
  RewriteRule ^category/medicina-estetica/?$ https://www.dottorfamaumberto.it/medicina-estetica-roma-aprilia/ [R=301,L]
  RewriteRule ^category/trattamenti-laser/?$ https://www.dottorfamaumberto.it/trattamenti-laser-roma-aprilia/ [R=301,L]
  RewriteRule ^chi-siamo/?$ https://www.dottorfamaumberto.it/chi-sono/ [R=301,L]
  RewriteRule ^filler-labbra-roma-eur-aprilia/?$ https://www.dottorfamaumberto.it/rimodellamento-labbra-roma/ [R=301,L]
  RewriteRule ^rinofiller-roma-aprilia/?$ https://www.dottorfamaumberto.it/rinofiller-roma/ [R=301,L]
  RewriteRule ^(project|servizi)/?$ https://www.dottorfamaumberto.it/ [R=301,L]

  # Pagine senza barra finale -> con barra finale (come sulla preview)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # Endpoint MCP in sola lettura (script PHP)
  RewriteRule ^mcp/?$ mcp.php [L,QSA]

  # Markdown per gli agenti AI: Accept: text/markdown -> index.md della stessa pagina
  RewriteCond %{HTTP:Accept} text/markdown [NC]
  RewriteCond %{DOCUMENT_ROOT}/$1index.md -f
  RewriteRule ^((?:.+/)?)(?:index\.html)?$ /$1index.md [L,E=MDNEG:1]
</IfModule>

<IfModule mod_headers.c>
  # Le pagine cambiano formato in base all'intestazione Accept
  <FilesMatch "\.(html|md)$">
    Header merge Vary Accept
  </FilesMatch>
  # Risorse per agenti sulla home
  <If "%{REQUEST_URI} =~ m#^/(index\.(html|md))?$#">
    Header set Link "</llms.txt>; rel=\"alternate\"; type=\"text/markdown\", </ai-catalog.json>; rel=\"describedby\"; type=\"application/json\", </sitemap.xml>; rel=\"sitemap\"; type=\"application/xml\", </.well-known/mcp/server-card.json>; rel=\"service-desc\"; type=\"application/json\""
  </If>
  <FilesMatch "^(server-card\.json|ai-catalog\.json|llms\.txt)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  # Sicurezza di base
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  # Cache: file statici a lungo, pagine sempre rivalidate
  <FilesMatch "\.(woff2|webp|jpe?g|png|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(html|md|txt|json|xml|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/markdown text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>
